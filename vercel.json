{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/vibes/(.*)", "destination": "/api/vibes/proxy?path=$1" }
  ],
  "functions": {
    "api/rwa/*.js": { "maxDuration": 30 },
    "api/vibes/proxy.js": { "maxDuration": 30 }
  }
}
